{

//"layer": "top", // Waybar at top layer
//"ipc": true,
"position": "bottom", // Waybar position (top|bottom|left|right)
"modules-left": ["hyprland/workspaces"],
"modules-right": ["network", "disk", "clock", "pulseaudio", "backlight", "cpu", "memory", "battery"],
"mode": "overlay",
"passthrough": true,
"sway/workspaces": {
	"disable-scroll": true,
	"all-outputs": true,
	"format": "{icon}",
	"format-icons": {
		"1": "\\", //一
		"2": "\\\\", //二
		"3": "\\\\\\", //三
		"4": " 四", //"\\\\\\\\",
		"5": " 五", //"V",
		"6": " 六", //"V\\",
		"7": " 七", //"V\\\\",
		"8": " 八", //"\\\\X",
		"9": " 九", //"\\X",
	 "10": " 十", //"X",
	}
},
"hyprland/workspaces": {
	"disable-scroll": true,
	"all-outputs": true,
	"format": "{icon}",
	"format-icons": {
		"1": "\\",
		"2": "\\\\",
		"3": "\\\\\\",
		"4": " 四",
		"5": " 五",
		"6": " 六",
		"7": " 七",
		"8": " 八",
		"9": " 九",
	 "10": " 十",
	}
},


"custom/test": {
	"exec" : "echo '{\"text\":\"text\", \"tooltip\":\"$(cal)\"}'",
	"return-type": "json",
	"interval": 1,
	"format": "A {} A",
	"tooltip-format": "A {tooltip} A"
},

		//"urgent": "!"
"sway/mode": {
	"format": "{}",
	"max-length": 50
},
"sway/language": {
	"format": "{short}"
},
"disk": {
	"interval": 10,
	"format": "{specific_free:.0f}",
	"unit":"MiB"
},
"tray": {
	"icon-size": 21,
	"spacing": 10
},
"clock": {
	"format": "{:%H%M}",
	"tooltip-format": "<tt><big>{calendar}</big></tt>",
	"format-alt": "{:%b %d:%w  }",
	//"calendar": {
	//	 "mode"          : "today",
	//	 "format": {
	//		  "months":     "<span color='#00ffff'>{}</span>",
	//		  "days":       "<span color='#00ffff'>{}</span>",
	//		  "weekdays":   "<span color='#00ffff'><b>{}</b></span>",
	//		  "today":      "<span color='#000000' background='#00ffff'><b>{}</b></span>"
	//	 }
	//}
},
"cpu": {
	"interval": 1,
	"format": "{icon}",
	"format-icons": ["🭻", "🭺", "🭹", "🭸", "🭷", "🭶"],
	"on-double-click": "foot -e btop",
	"tooltip": true,
	//"format": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
	"states": {
		"warning": 70,
		"critical": 95
	}
},
"memory": {
	"format": "{icon}",
	"format-icons": ["🭻", "🭺", "🭹", "🭸", "🭷", "🭶"],
	"states": {
		"warning": 70,
		"critical": 95
	}
},
"temperature": {
	"critical-threshold": 80,
	"format": "t{temperatureC}"
},
"backlight": {
	"device": "nvidia_wmi_ec_backlight",
	"format": "{icon}",
	"format-icons": ["🭻", "🭺", "🭹", "🭸", "🭷", "🭶"],
	"on-scroll-up": "light -A 1",
	"on-scroll-down": "light -U 1",
},
"battery": {
	"interval": 1,
	"states": {
		"warning": 30,
		"critical": 15
	},
	"format-charging": "{icon}",
   "format-plugged": "{icon}",
	"format-time": "~{H}:{m}",
	"format": "{icon}", //🗲
	"format-icons": ["!!!", "!!", "!", "🭸", "🭷", "🭶"],
	"format-alt": "{time} {capacity}%"
},
"network": {
	"format-wifi": "{signalStrength}",
	"format": "N{icon}",
	"format-ethernet": "",
	//"format-ethernet": "{ipaddr}",
	"format-linked": "\\\\",
	"format-disconnected": "OFFLINE",
	"tooltip": false
},
"pulseaudio": {
	"format": "{icon}",
	"format-icons": ["🭻", "🭺", "🭹", "🭸", "🭷", "🭶"],
	"on-click": "foot pulsemixer",
	"tooltip": true,
	"tooltip-format": "{volume}"
}

}
